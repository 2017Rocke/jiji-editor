<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <AssemblyName>JijiEditor</AssemblyName>
    <RootNamespace>JijiEditor</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('../../build/AppIcon.ico')">../../build/AppIcon.ico</ApplicationIcon>
    <Product>吉吉编辑软件</Product>
    <Description>在独立窗口中编辑、裁剪和导出本机文档</Description>
    <Copyright>吉吉编辑软件 contributors</Copyright>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <Reference Include="System.Web.Extensions" />
    <Content Include="NativeVerification.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
